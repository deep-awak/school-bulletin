{
  "info": {
    "name": "School Bulletin API",
    "description": "Matches api.yaml and the real controllers in src/main/java/api/poja/app/endpoint. Auth is the X-User-Id header (no JWT/login flow exists in this project - the 'token' variable below is kept unused for forward compatibility only, see README).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "1", "description": "Value sent as X-User-Id; set it to an ADMIN app_user id to run the admin-only requests" },
    { "key": "studentId", "value": "" },
    { "key": "teacherId", "value": "" },
    { "key": "courseId", "value": "" },
    { "key": "groupId", "value": "" },
    { "key": "promotionId", "value": "" },
    { "key": "gradeId", "value": "" }
  ],
  "item": [
    {
      "name": "Promotions",
      "item": [
        {
          "name": "Create promotion",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/promotions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Promotion 2026\",\n  \"startYear\": 2023,\n  \"endYear\": 2026\n}"
            }
          }
        },
        {
          "name": "List promotions",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/promotions" }
        },
        {
          "name": "Get promotion by id",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/promotions/{{promotionId}}" }
        }
      ]
    },
    {
      "name": "Groups",
      "item": [
        {
          "name": "Create group",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/groups",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"G1\",\n  \"promotionId\": {{promotionId}}\n}"
            }
          }
        },
        {
          "name": "List groups of a promotion",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/groups?promotionId={{promotionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "groups"],
              "query": [{ "key": "promotionId", "value": "{{promotionId}}" }]
            }
          }
        },
        {
          "name": "Get group by id",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/groups/{{groupId}}" }
        }
      ]
    },
    {
      "name": "Teachers",
      "item": [
        {
          "name": "Create teacher",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/teachers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Herimanana\",\n  \"lastName\": \"Rabe\",\n  \"email\": \"herimanana.rabe@hei.mg\"\n}"
            }
          }
        },
        {
          "name": "List teachers",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/teachers" }
        },
        {
          "name": "Get teacher by id",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/teachers/{{teacherId}}" }
        }
      ]
    },
    {
      "name": "Courses",
      "item": [
        {
          "name": "Create course",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/courses",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Algorithmique\",\n  \"code\": \"ALG1\"\n}"
            }
          }
        },
        {
          "name": "List courses",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/courses" }
        },
        {
          "name": "Get course by id",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/courses/{{courseId}}" }
        },
        {
          "name": "Assign teacher to course/group (CourseTeaching)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/courses/teaching-assignments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseId\": {{courseId}},\n  \"teacherId\": {{teacherId}},\n  \"groupId\": {{groupId}},\n  \"academicYear\": \"2025-2026\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Students",
      "item": [
        {
          "name": "Create student",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/students",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"std\": \"HEI-2023-014\",\n  \"firstName\": \"Jean\",\n  \"lastName\": \"Rakoto\",\n  \"email\": \"jean.rakoto@hei.mg\",\n  \"promotionId\": {{promotionId}},\n  \"groupId\": {{groupId}}\n}"
            }
          }
        },
        {
          "name": "List students of a promotion",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/students?promotionId={{promotionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"],
              "query": [{ "key": "promotionId", "value": "{{promotionId}}" }]
            }
          }
        },
        {
          "name": "Get student by id",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/students/{{studentId}}" }
        },
        {
          "name": "Reassign student to a new group",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/students/group-assignments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": {{studentId}},\n  \"groupId\": {{groupId}},\n  \"startDate\": \"2025-09-01\"\n}"
            }
          }
        },
        {
          "name": "Student group assignment history",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/students/{{studentId}}/group-history" }
        }
      ]
    },
    {
      "name": "Grades",
      "item": [
        {
          "name": "Create grade (TEACHER of the course, or ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": "{{baseUrl}}/api/grades",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": {{studentId}},\n  \"courseId\": {{courseId}},\n  \"academicYear\": \"2025-2026\",\n  \"value\": 14.5\n}"
            }
          }
        },
        {
          "name": "List a student's grades (self, or TEACHER/ADMIN)",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/grades?studentId={{studentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "grades"],
              "query": [{ "key": "studentId", "value": "{{studentId}}" }]
            }
          }
        },
        {
          "name": "Update grade (mandatory reason, kept in history)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": "{{baseUrl}}/api/grades/{{gradeId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"value\": 16,\n  \"reason\": \"Erreur de saisie corrigée après réclamation de l'étudiant\"\n}"
            }
          }
        },
        {
          "name": "Grade modification history",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
            "url": "{{baseUrl}}/api/grades/{{gradeId}}/history"
          }
        }
      ]
    },
    {
      "name": "Transcripts",
      "item": [
        {
          "name": "Generate transcript PDF + upload to S3 (returns URL)",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/transcripts/generate?studentId={{studentId}}&academicYear=2025-2026",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transcripts", "generate"],
              "query": [
                { "key": "studentId", "value": "{{studentId}}" },
                { "key": "academicYear", "value": "2025-2026" }
              ]
            }
          }
        },
        {
          "name": "Send transcript by email (async via POJA)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": "{{baseUrl}}/api/transcripts/send",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": {{studentId}},\n  \"academicYear\": \"2025-2026\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Graduates / Admin",
      "item": [
        {
          "name": "Promotion ranking (ADMIN)",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
            "url": "{{baseUrl}}/api/promotions/{{promotionId}}/graduates"
          }
        },
        {
          "name": "Excel export of a promotion's graduates (ADMIN, via API)",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
            "url": "{{baseUrl}}/api/promotions/{{promotionId}}/graduates/export"
          }
        },
        {
          "name": "Results across several promotions (ADMIN, e.g. 3-year view)",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/promotions/{{promotionId}}/graduates/results?promotionIds={{promotionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "promotions", "{{promotionId}}", "graduates", "results"],
              "query": [{ "key": "promotionIds", "value": "{{promotionId}}" }]
            }
          }
        }
      ]
    },
    {
      "name": "Thymeleaf (no auth)",
      "item": [
        {
          "name": "Promotions list page",
          "request": { "method": "GET", "url": "{{baseUrl}}/promotions" }
        },
        {
          "name": "Promotion detail page",
          "request": { "method": "GET", "url": "{{baseUrl}}/promotions/{{promotionId}}" }
        },
        {
          "name": "Excel export from the Thymeleaf page",
          "request": { "method": "GET", "url": "{{baseUrl}}/promotions/{{promotionId}}/export" }
        }
      ]
    }
  ]
}
